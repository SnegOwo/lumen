<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- =====================================================================
         Icon glyphs.

         The app draws its icons with the Segoe Fluent Icons / Segoe MDL2
         Assets fonts. The glyphs live in the Unicode private use area, so
         they are published here as named string resources instead of being
         repeated as magic numbers across the views.

         Usage
         =====
             <TextBlock Text="{StaticResource Icon.Shield}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />

         Every glyph below is a private use codepoint: it must always be
         paired with AutomationProperties.Name="" (or an accessible name on the
         surrounding element) so that a screen reader never announces the raw
         codepoint.
         ===================================================================== -->

    <!-- Navigation -->
    <sys:String x:Key="Icon.Home">&#xE80F;</sys:String>          <!-- Home -->
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>        <!-- Search / scan -->
    <sys:String x:Key="Icon.Scan">&#xE721;</sys:String>          <!-- Scan, alias of Search -->
    <sys:String x:Key="Icon.Trash">&#xE72E;</sys:String>          <!-- Trash -->
    <sys:String x:Key="Icon.List">&#xE81C;</sys:String>          <!-- List -->
    <sys:String x:Key="Icon.Gear">&#xE713;</sys:String>           <!-- Settings -->
    <sys:String x:Key="Icon.Profile">&#xE77B;</sys:String>       <!-- Profile -->

    <!-- Actions -->
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>        <!-- Refresh -->
    <sys:String x:Key="Icon.FullScan">&#xE9D9;</sys:String>      <!-- Full scan -->
    <sys:String x:Key="Icon.Radar">&#xE9F9;</sys:String>         <!-- Radar / scan -->
    <sys:String x:Key="Icon.Dismiss">&#xE711;</sys:String>        <!-- Dismiss / cancel -->
    <sys:String x:Key="Icon.Chevron">&#xE76C;</sys:String>        <!-- Chevron -->

    <!-- Theme -->
    <sys:String x:Key="Icon.Moon">&#xE706;</sys:String>           <!-- Dark theme -->
    <sys:String x:Key="Icon.Sun">&#xE708;</sys:String>            <!-- Light theme -->
    <sys:String x:Key="Icon.SystemTheme">&#xE770;</sys:String>   <!-- System theme -->

    <!-- Files -->
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>         <!-- Folder -->
    <sys:String x:Key="Icon.File">&#xE7C3;</sys:String>           <!-- File -->

    <!-- Security -->
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>         <!-- Shield -->
    <sys:String x:Key="Icon.ScriptRule">&#xE943;</sys:String>    <!-- Script rule -->
    <sys:String x:Key="Icon.FilenameRule">&#xE8A5;</sys:String>  <!-- Filename rule -->

    <!-- Status -->
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>           <!-- Info -->
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>       <!-- Warning -->
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>         <!-- Error -->
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>         <!-- Check -->

</ResourceDictionary>
