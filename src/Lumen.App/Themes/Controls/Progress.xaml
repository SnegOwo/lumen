<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Progress.

         The template supports both modes.

         Determinate: the bar is built from the standard WPF template parts
         (PART_Track and PART_Indicator). ProgressBar measures the indicator
         against the track, so the fill really does follow Value. The old
         template ignored Value completely and a determinate bar rendered
         nothing at all.

         Indeterminate: the sweeping pulse is shown instead, and only then.
         ===================================================================== -->

    <Style x:Key="ScanProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Progress.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Progress.Fill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="Transparent" ClipToBounds="True">
                        <Border Background="{DynamicResource Progress.Track}" CornerRadius="{StaticResource Radius.Xs}" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="{StaticResource Radius.Xs}"
                                Background="{TemplateBinding Foreground}" />
                        <Border x:Name="Pulse" Width="190" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.Xs}"
                                Background="{TemplateBinding Foreground}" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform X="-220" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pulse" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-220" To="1600" Duration="0:0:1.7">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="False">
                            <Setter TargetName="Pulse" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
