<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Chips and badges.

         Small, fully rounded labels that sit next to a value. They use the
         pill radius so a chip never reads as a button.
         ===================================================================== -->

    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Chip.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Chip.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="{StaticResource Space.Inset.Xs}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Chip.Text}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="{StaticResource Space.Inset.Tight}" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
