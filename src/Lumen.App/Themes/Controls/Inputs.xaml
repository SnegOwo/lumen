<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
        <ResourceDictionary Source="Focus.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- =====================================================================
         Input controls.

         ToggleSwitch, SelectionCheckBox, PillRadio and ChoiceCard all carry
         hover, checked, pressed and disabled states.

         Removed in this revision: InputTextBox, which was unreferenced
         anywhere in the app.

         Added in this revision: RangeSlider, a themed replacement for the
         stock WPF slider that the settings page used to fall back on.
         ===================================================================== -->

    <!-- ===================== Switch ===================== -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="{StaticResource Space.Horizontal.Lg}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <Border x:Name="Track" Grid.Column="1" Width="42" Height="24"
                                CornerRadius="{StaticResource Radius.Lg}"
                                Background="{DynamicResource Toggle.TrackOff}">
                            <Ellipse x:Name="Knob" Width="18" Height="18"
                                     Fill="{DynamicResource Toggle.Knob}"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Toggle.TrackOn}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Checkbox ===================== -->

    <Style x:Key="SelectionCheckBox" TargetType="CheckBox">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource Radius.Xs}"
                            Background="{DynamicResource Input.Background}"
                            BorderBrush="{DynamicResource Input.Border}"
                            BorderThickness="{StaticResource Border.Thickness.Hairline}">
                        <Path x:Name="Check" Data="M 3.5,9 L 7.5,13 L 14.5,5"
                              Stroke="{DynamicResource Accent.OnPrimary}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Pill radio ===================== -->

    <Style x:Key="PillRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="{StaticResource Space.Pill}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.Md}" BorderThickness="{StaticResource Border.Thickness.Hairline}"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.SoftBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Choice card ===================== -->

    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.Lg}" BorderThickness="{StaticResource Border.Thickness.Hairline}"
                            BorderBrush="{DynamicResource App.Border}"
                            Background="{DynamicResource App.SurfaceAlt}"
                            Padding="{StaticResource Space.Md}">
                        <ContentPresenter VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.SoftBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Range slider ===================== -->

    <Style x:Key="RangeSlider" TargetType="Slider">
        <Setter Property="Height" Value="{StaticResource Control.Height.Medium}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Track x:Name="PART_Track" Grid.Row="0" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" VerticalAlignment="Center"
                                                    CornerRadius="{StaticResource Radius.Xs}"
                                                    Background="{TemplateBinding Foreground}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="18" Height="18" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob"
                                                     Width="16" Height="16"
                                                     Fill="{DynamicResource App.Surface}"
                                                     Stroke="{TemplateBinding Foreground}"
                                                     StrokeThickness="{StaticResource Border.Width.Thick}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Accent.PrimaryHover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Accent.PrimaryPressed}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" VerticalAlignment="Center"
                                                    CornerRadius="{StaticResource Radius.Xs}"
                                                    Background="{DynamicResource App.Border}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <TickBar x:Name="PART_TickBar"
                                 Grid.Row="1"
                                 Height="4"
                                 Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}"
                                 TickFrequency="{TemplateBinding TickFrequency}"
                                 Placement="{TemplateBinding TickPlacement}"
                                 IsDirectionReversed="False"
                                 Fill="{DynamicResource App.BorderStrong}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
