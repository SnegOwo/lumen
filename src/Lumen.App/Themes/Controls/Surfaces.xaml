<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Surfaces.

         Elevation model
         ============
         Cards are flat: a one pixel border plus a background that is a shade
         away from the page. They deliberately do NOT carry a drop shadow.
         Nine simultaneously blurred, software rendered shadows on one
         scrolling page were the single biggest cost in the old theme; the
         border and the tinted fill carry the same hierarchy for free.

         Card.Effect is still honoured (it resolves to a null effect in every
         theme) so a future theme can opt into real elevation without
         touching the styles.

         Removed in this revision: CardFlat, which was unreferenced.
         ===================================================================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}" />
        <Setter Property="Padding" Value="{StaticResource Space.Lg}" />
        <Setter Property="Effect" Value="{DynamicResource Card.Effect}" />
    </Style>

    <!-- A recessed panel: used for grouped detail blocks inside a card. -->
    <Style x:Key="InsetCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thickness.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Space.Md}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
        <Setter Property="Margin" Value="{StaticResource Space.Vertical.Md}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
