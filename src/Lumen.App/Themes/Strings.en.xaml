    <sys:String x:Key="Strings.Settings.Title">Settings</sys:String>
    <sys:String x:Key="Strings.Settings.Subtitle">Tune the scanner and decide how Lumen behaves. Everything is stored locally in this Windows account.</sys:String>
    <sys:String x:Key="Strings.Settings.SavedAutomatically">SAVED AUTOMATICALLY</sys:String>
    <sys:String x:Key="Strings.Settings.SaveErrorTitle">A setting could not be saved</sys:String>
    <sys:String x:Key="Strings.Settings.AppearanceTitle">Appearance</sys:String>
    <sys:String x:Key="Strings.Settings.AppearanceBody">Choose a theme. High contrast mode from Windows always takes priority.</sys:String>
    <sys:String x:Key="Strings.Settings.ThemeSystem">System</sys:String>
    <sys:String x:Key="Strings.Settings.ThemeSystemName">Use the Windows theme</sys:String>
