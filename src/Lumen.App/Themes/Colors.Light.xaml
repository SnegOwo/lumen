<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. All brushes are referenced with DynamicResource so the whole
         app can switch themes at runtime without recreating windows. -->

    <SolidColorBrush x:Key="App.Background" Color="#F4F7FB" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="App.SurfaceCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="App.SurfacePressed" Color="#E2E8F0" />
    <SolidColorBrush x:Key="App.Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="#CBD5E1" />
    <SolidColorBrush x:Key="App.TextPrimary" Color="#0B1220" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#475569" />
    <SolidColorBrush x:Key="App.TextMuted" Color="#64748B" />

    <!-- Shadow tint used by the drop shadows that still exist (tool tips,
         modal dialogs). Replaces hard coded black. -->
    <Color x:Key="App.ShadowColor">#0F172A</Color>

    <SolidColorBrush x:Key="Sidebar.Background" Color="#0B1B2B" />
    <SolidColorBrush x:Key="Sidebar.Border" Color="#16283C" />
    <SolidColorBrush x:Key="Sidebar.Text" Color="#DCE6F2" />
    <SolidColorBrush x:Key="Sidebar.TextMuted" Color="#8FA3B8" />
    <SolidColorBrush x:Key="Sidebar.Hover" Color="#122539" />
    <SolidColorBrush x:Key="Sidebar.Selected" Color="#123244" />
    <SolidColorBrush x:Key="Sidebar.SelectedText" Color="#F0FDFA" />
    <SolidColorBrush x:Key="Sidebar.Accent" Color="#2DD4BF" />
    <SolidColorBrush x:Key="Sidebar.Card" Color="#102235" />

    <SolidColorBrush x:Key="Accent.Primary" Color="#0F766E" />
    <SolidColorBrush x:Key="Accent.PrimaryHover" Color="#115E59" />
    <SolidColorBrush x:Key="Accent.PrimaryPressed" Color="#134E4A" />
    <SolidColorBrush x:Key="Accent.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#CCFBF1" />
    <SolidColorBrush x:Key="Accent.SoftBorder" Color="#99F6E4" />
    <SolidColorBrush x:Key="Accent.Text" Color="#0F766E" />

    <SolidColorBrush x:Key="Success.Text" Color="#15803D" />
    <SolidColorBrush x:Key="Success.Soft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Warning.Text" Color="#B45309" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Danger.Primary" Color="#B91C1C" />
    <SolidColorBrush x:Key="Danger.PrimaryHover" Color="#991B1B" />
    <SolidColorBrush x:Key="Danger.PrimaryPressed" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Danger.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger.Text" Color="#B91C1C" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Danger.SoftBorder" Color="#FECACA" />
    <SolidColorBrush x:Key="Info.Text" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Info.Soft" Color="#DBEAFE" />

    <SolidColorBrush x:Key="Chip.Background" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Chip.Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Chip.Text" Color="#475569" />

    <!-- ================= Hero (dark gradient island) =================
         The hero is a dark island in the light theme, so its controls stay
         light on dark: a near white button with dark teal text, and a ghost
         button that is a translucent white. -->

    <LinearGradientBrush x:Key="Hero.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1B2B" Offset="0" />
        <GradientStop Color="#0E2B36" Offset="0.55" />
        <GradientStop Color="#12414A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hero.Border" Color="#1D4C57" />
    <SolidColorBrush x:Key="Hero.Text" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Hero.TextMuted" Color="#B6C8D8" />
    <SolidColorBrush x:Key="Hero.BadgeBackground" Color="#1E4B54" />
    <SolidColorBrush x:Key="Hero.BadgeText" Color="#7DE6D7" />
    <RadialGradientBrush x:Key="Hero.Glow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#552DD4BF" Offset="0" />
        <GradientStop Color="#002DD4BF" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Hero.ButtonBg" Color="#F0FDFA" />
    <SolidColorBrush x:Key="Hero.ButtonFg" Color="#082F2C" />
    <SolidColorBrush x:Key="Hero.ButtonBgHover" Color="#CCFBF1" />
    <SolidColorBrush x:Key="Hero.ButtonBgPressed" Color="#99F6E4" />
    <SolidColorBrush x:Key="Hero.ButtonBorder" Color="#F0FDFA" />
    <SolidColorBrush x:Key="Hero.GhostBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Hero.GhostFg" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Hero.GhostBorder" Color="#3B6470" />
    <SolidColorBrush x:Key="Hero.Ring" Color="#552DD4BF" />
    <SolidColorBrush x:Key="Hero.GlyphFg" Color="#7DE6D7" />

    <SolidColorBrush x:Key="Progress.Track" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Progress.Fill" Color="#14B8A6" />

    <SolidColorBrush x:Key="Toggle.TrackOff" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Toggle.TrackOn" Color="#0F766E" />
    <SolidColorBrush x:Key="Toggle.Knob" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Input.Border" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Input.BorderFocus" Color="#0F766E" />

    <SolidColorBrush x:Key="Tooltip.Background" Color="#0B1220" />
    <SolidColorBrush x:Key="Tooltip.Text" Color="#F8FAFC" />

    <!-- Elevation: cards are flat. A one pixel border and a tinted fill carry
         the hierarchy, so no blur effect is rendered at all. -->
    <x:Null x:Key="Card.Effect" />
</ResourceDictionary>
