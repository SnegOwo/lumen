<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Control theme aggregator.

         App.xaml merges this single file. Everything below is split into
         focused dictionaries so that a change stays in one place:

           Tokens.xaml          spacing, radii, type, icon sizes, motion
           Icons.xaml           Segoe icon glyphs as named strings
           Controls/Base.xaml   window chrome
           Controls/Focus.xaml  the shared focus ring
           Controls/Typography.xaml
           Controls/Buttons.xaml
           Controls/Inputs.xaml
           Controls/Surfaces.xaml
           Controls/Chips.xaml
           Controls/Lists.xaml
           Controls/Progress.xaml
           Controls/Scrollbars.xaml
           Controls/Tooltips.xaml

         The colour dictionaries (Themes/Colors.*.xaml) are NOT merged here:
         ThemeService swaps them at runtime, so they have to stay separate.
         ===================================================================== -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Controls/Base.xaml" />
        <ResourceDictionary Source="Controls/Focus.xaml" />
        <ResourceDictionary Source="Controls/Typography.xaml" />
        <ResourceDictionary Source="Controls/Buttons.xaml" />
        <ResourceDictionary Source="Controls/Inputs.xaml" />
        <ResourceDictionary Source="Controls/Surfaces.xaml" />
        <ResourceDictionary Source="Controls/Chips.xaml" />
        <ResourceDictionary Source="Controls/Lists.xaml" />
        <ResourceDictionary Source="Controls/Progress.xaml" />
        <ResourceDictionary Source="Controls/Scrollbars.xaml" />
        <ResourceDictionary Source="Controls/Tooltips.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
