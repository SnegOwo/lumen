<UserControl x:Class="Lumen.App.Controls.Banner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:Lumen.App.Dialogs"
             xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
    </UserControl.Resources>

    <Border x:Name="Bar"
            CornerRadius="12"
            BorderThickness="0"
            Padding="12,12"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding Title, ElementName=Root}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Info.Soft}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Success}">
                        <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Warning}">
                        <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Danger}">
                        <Setter Property="Background" Value="{DynamicResource Danger.Soft}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Icon"
                       Grid.Column="0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="{StaticResource Icon.Size.Medium}"
                       Margin="{StaticResource Space.Horizontal.Md}"
                       VerticalAlignment="Top"
                       Text="{StaticResource Icon.Info}"
                       AutomationProperties.Name="">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Info.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Success}">
                                <Setter Property="Text" Value="{StaticResource Icon.Check}" />
                                <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Warning}">
                                <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="{x:Static dialogs:MessageSeverity.Danger}">
                                <Setter Property="Text" Value="{StaticResource Icon.Error}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger.Text}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimary}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Title, ElementName=Root, Converter={StaticResource EmptyStringToVisibility}}" />
                <TextBlock Text="{Binding Message, ElementName=Root}"
                           FontSize="12.5"
                           Foreground="{DynamicResource App.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource Space.Top.Xs}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Width="{StaticResource Control.Height.Small}" Height="{StaticResource Control.Height.Small}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Top"
                    Content="{StaticResource Icon.Dismiss}"
                    ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss message"
                    Visibility="{Binding ShowClose, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding CloseCommand, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
