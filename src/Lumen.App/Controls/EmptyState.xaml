<UserControl x:Class="Lumen.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="500">
    <UserControl.Resources>
        <infra:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
        <Border Width="68" Height="68" CornerRadius="20"
                Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding Glyph, ElementName=Root}"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="27"
                       Foreground="{DynamicResource Accent.Text}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource SectionTitle}"
                   FontSize="18"
                   TextAlignment="Center"
                   Margin="0,18,0,0" />

        <TextBlock Text="{Binding Message, ElementName=Root}"
                   Style="{StaticResource BodySecondary}"
                   TextAlignment="Center"
                   LineHeight="20"
                   Margin="0,8,0,0" />

        <Button Style="{StaticResource PrimaryButton}"
                Content="{Binding ActionText, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                MinWidth="140"
                AutomationProperties.Name="{Binding ActionText, ElementName=Root}"
                Visibility="{Binding ActionText, ElementName=Root, Converter={StaticResource EmptyStringToVisibility}}" />
    </StackPanel>
</UserControl>
