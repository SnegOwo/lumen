<Window x:Class="Lumen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Lumen.App.Controls"
        xmlns:views="clr-namespace:Lumen.App.Views"
        xmlns:vm="clr-namespace:Lumen.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1320" Height="840"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/lumen.ico"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.TextPrimary}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="scan" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="quarantine" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="history" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="settings" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding QuickScanCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Scan.CancelScanCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource Sidebar.Background}"
                BorderBrush="{DynamicResource Sidebar.Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Grid Grid.Row="0" Margin="22,23,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="{DynamicResource Sidebar.Card}"
                            BorderBrush="{DynamicResource Sidebar.Border}"
                            BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/lumen.ico"
                               Width="34"
                               Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="{DynamicResource Strings.Main.LogoName}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lumen"
                                   FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sidebar.SelectedText}" />
                        <TextBlock Text="{DynamicResource Strings.Main.Strapline}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Sidebar.TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{DynamicResource Strings.Main.Strapline}"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{DynamicResource Strings.Main.Workspace}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Sidebar.TextMuted}"
                               Margin="25,4,0,7" />

                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="MainNavigation"
                                             Style="{StaticResource NavButton}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding SelectCommand}"
                                             AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.Name="">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Home}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Key}" Value="scan">
                                                            <Setter Property="Text" Value="{StaticResource Icon.Scan}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Key}" Value="quarantine">
                                                            <Setter Property="Text" Value="{StaticResource Icon.Trash}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Key}" Value="history">
                                                            <Setter Property="Text" Value="{StaticResource Icon.List}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Key}" Value="settings">
                                                            <Setter Property="Text" Value="{StaticResource Icon.Gear}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,8,0"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="2"
                                                Style="{StaticResource BadgeBorder}"
                                                Background="{DynamicResource Sidebar.Card}"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource Sidebar.Accent}" />
                                        </Border>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource Sidebar.Border}" Margin="22,16" />

                    <Border Background="{DynamicResource Sidebar.Card}"
                            CornerRadius="12"
                            Padding="14,13"
                            Margin="14,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Shield}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Sidebar.Accent}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Main.OnDemandOnly}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sidebar.Text}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Main.OnDemandBody}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Sidebar.TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="22,0,22,20">
                    <TextBlock Text="{DynamicResource Strings.Main.KeepDefender}"
                               FontSize="11"
                               Foreground="{DynamicResource Sidebar.TextMuted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Settings.VersionText}"
                               FontSize="11"
                               Foreground="{DynamicResource Sidebar.TextMuted}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource App.Background}"
                    Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Success.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Accent.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderStatusText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   controls:LiveRegion.IsEnabled="True" />
                        <Border Width="1" Height="12" Background="{DynamicResource App.Border}" Margin="10,0" />
                        <TextBlock Text="{Binding HeaderStatusDetail}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"
                                   controls:LiveRegion.IsEnabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Width="34" Height="34"
                                Command="{Binding ToggleThemeCommand}"
                                IsEnabled="{Binding CanToggleTheme}"
                                ToolTip="{Binding ThemeTooltip}"
                                AutomationProperties.Name="{Binding ThemeTooltip}">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{StaticResource Icon.Sun}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Icon.Moon}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UsesSystemTheme}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Icon.SystemTheme}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Width="34" Height="34"
                                Content="{StaticResource Icon.Gear}"
                                Command="{Binding OpenSettingsCommand}"
                                Margin="4,0,0,0"
                                ToolTip="{DynamicResource Strings.Main.SettingsTooltip}"
                                AutomationProperties.Name="{DynamicResource Strings.Main.SettingsName}" />
                        <Border Width="1" Height="22" Background="{DynamicResource App.Border}" Margin="12,0" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Command="{Binding QuickScanCommand}"
                                AutomationProperties.Name="{DynamicResource Strings.Main.QuickScanName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Search}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Main.QuickScan}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The pages. They are created once and kept, so that navigating away
                 and back does not lose the scroll position or the selection. -->
            <Grid Grid.Row="1" Margin="28,22,28,26">
                <views:DashboardView DataContext="{Binding Dashboard}"
                                     Visibility="{Binding DataContext.IsDashboardCurrent, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}" />
                <views:ScanView DataContext="{Binding Scan}"
                                Visibility="{Binding DataContext.IsScanCurrent, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}" />
                <views:QuarantineView DataContext="{Binding Quarantine}"
                                      Visibility="{Binding DataContext.IsQuarantineCurrent, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}" />
                <views:HistoryView DataContext="{Binding History}"
                                   Visibility="{Binding DataContext.IsHistoryCurrent, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsCurrent, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
