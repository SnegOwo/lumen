<Window x:Class="Lumen.App.Remediation.RemediationPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Lumen.App.Controls"
        mc:Ignorable="d"
        d:DesignWidth="720"
        d:DesignHeight="640"
        Title="{Binding TitleText}"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.TextPrimary}">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
            <StackPanel Margin="24,22,24,8">

                <!-- What the plan is about -->
                <Border Style="{StaticResource InsetCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Strings.Remediation.File}"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}" />
                        <TextBlock Text="{Binding FilePath}"
                                   Style="{StaticResource Mono}"
                                   FontSize="11.5"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}" />

                        <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,12,0,10" />

                        <TextBlock Text="{DynamicResource Strings.Remediation.Finding}"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FindingTitle}"
                                   Style="{StaticResource Label}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetail}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasFindingDetail, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- The promise: nothing has happened yet -->
                <Border Background="{DynamicResource Info.Soft}"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource Info.Text}"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Top"
                                   AutomationProperties.Name="" />
                        <TextBlock Text="{DynamicResource Strings.Remediation.Intro}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource App.TextPrimary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- The steps -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Strings.Remediation.Steps}"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource SelectionCheckBox}"
                                  IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectSteps}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource Strings.Remediation.SelectAll}" />
                        <TextBlock Text="{DynamicResource Strings.Remediation.SelectAll}"
                                   Style="{StaticResource Caption}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InsetCard}" Margin="0,10,0,0" Padding="0,4">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource SelectionCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.CanSelectSteps, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,12,0"
                                              AutomationProperties.Name="{Binding KindLabel}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Style="{StaticResource Label}"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodySecondary}"
                                                   Margin="0,3,0,0" />

                                        <TextBlock Text="{Binding ProcessText}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding ProcessText, Converter={StaticResource EmptyStringToVisibility}}" />

                                        <TextBlock Text="{Binding PathText}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PathText}"
                                                   Visibility="{Binding PathText, Converter={StaticResource EmptyStringToVisibility}}" />

                                        <StackPanel Margin="0,6,0,0"
                                                    Visibility="{Binding LocationText, Converter={StaticResource EmptyStringToVisibility}}">
                                            <TextBlock Text="{Binding LocationText}"
                                                       Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LocationText}" />
                                            <TextBlock Text="{Binding EntryTargetText}"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding EntryTargetText}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding SignatureText}"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding HasSignature, Converter={StaticResource BooleanToVisibility}}" />

                                        <!-- Outcome, shown once the run happened -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasOutcome, Converter={StaticResource BooleanToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Danger.Text}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OutcomeText}"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{DynamicResource Strings.Remediation.NoSteps}"
                           Style="{StaticResource BodySecondary}"
                           Margin="2,12,0,0"
                           Visibility="{Binding HasSteps, Converter={StaticResource InverseBooleanToVisibility}}" />

                <!-- The outcome of the run -->
                <Border Style="{StaticResource InsetCard}"
                        Margin="0,16,0,0"
                        Padding="16,14"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ResultMessage}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- A failure that stopped the run -->
                <Border Background="{DynamicResource Danger.Soft}"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ErrorText}"
                               FontSize="12.5"
                               Foreground="{DynamicResource App.TextPrimary}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource App.SurfaceAlt}"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PlanHint}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Strings.Remediation.Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnCancelClicked"
                            MinWidth="104"
                            AutomationProperties.Name="{DynamicResource Strings.Remediation.Cancel}" />
                    <Button x:Name="ExecuteButton"
                            Content="{DynamicResource Strings.Remediation.Confirm}"
                            Style="{StaticResource DangerButton}"
                            Margin="8,0,0,0"
                            MinWidth="220"
                            Click="OnExecuteClicked"
                            Visibility="{Binding CanSelectSteps, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.Name="{DynamicResource Strings.Remediation.Confirm}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
