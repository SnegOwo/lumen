<UserControl x:Class="Lumen.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.History.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerOutlineButton}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="{DynamicResource Strings.History.Clear}"
                            Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.Name="{DynamicResource Strings.History.ClearName}" />
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            Content="{StaticResource Icon.Refresh}"
                            Margin="8,0,0,0"
                            ToolTip="{DynamicResource Strings.History.Refresh}"
                            AutomationProperties.Name="{DynamicResource Strings.History.RefreshName}" />
                </StackPanel>
            </Grid>

            <controls:Banner Title="{DynamicResource Strings.History.ReadWarningTitle}"
                             Message="{Binding LoadWarning}"
                             Severity="Warning"
                             Margin="0,0,0,14"
                             Visibility="{Binding LoadWarning, Converter={StaticResource EmptyStringToVisibility}}" />

            <controls:Banner Title="{Binding BannerTitle}"
                             Message="{Binding BannerMessage}"
                             Severity="{Binding BannerSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissBannerCommand}"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibility}}" />

            <!-- The banner is announced to a screen reader. -->
            <Grid Height="0">
                <TextBlock Text="{Binding BannerAnnouncement}"
                           controls:LiveRegion.IsEnabled="True" />
            </Grid>

            <!-- Empty -->
            <Border Style="{StaticResource Card}"
                    MinHeight="390"
                    Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibility}}">
                <controls:EmptyState Glyph="{StaticResource Icon.List}"
                                     Title="{DynamicResource Strings.History.EmptyTitle}"
                                     Message="{DynamicResource Strings.History.EmptyMessage}"
                                     ActionText="{DynamicResource Strings.History.RunQuickScan}"
                                     ActionCommand="{Binding StartQuickScanCommand}" />
            </Border>

            <!-- History -->
            <Grid Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" MinHeight="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Strings.History.Scans}" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding StoredCountText}" Style="{StaticResource Caption}" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource CleanListBox}"
                                 ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 MaxHeight="550"
                                 AutomationProperties.Name="{DynamicResource Strings.History.EntriesName}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource App.SurfaceAlt}"
                                                VerticalAlignment="Top">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{StaticResource Icon.Check}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetections}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Cancelled}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Dismiss}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding DateText}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding MetaText}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11" />
                                                <TextBlock Text="&#x00B7;"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11"
                                                           Margin="6,0" />
                                                <TextBlock Text="{Binding ScopeLabel}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource ChipBorder}"
                                                VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ChipText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" MinHeight="480">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="560"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DetailTitle}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailWhen}"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding DetailScope}"
                                           Style="{StaticResource Label}"
                                           Foreground="{DynamicResource App.TextSecondary}"
                                           Margin="0,8,0,0" />

                                <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Strings.History.Inspected}" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.FilesScanned, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource Strings.History.Findings}" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.DetectionCount, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Strings.History.Warnings}" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.ErrorCount, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{DynamicResource Strings.History.Duration}" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding DetailDuration}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding DetailCounts}"
                                           Style="{StaticResource BodySecondary}"
                                           FontSize="12.5"
                                           Margin="0,10,0,0" />

                                <TextBlock Text="{DynamicResource Strings.History.Locations}" Style="{StaticResource Label}" FontSize="12" Margin="0,16,0,0" />
                                <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0" Padding="12,10">
                                    <TextBlock Text="{Binding DetailRoots}"
                                               Style="{StaticResource Mono}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailRoots}" />
                                </Border>

                                <TextBlock Text="{Binding DetailErrorsCaption}"
                                           Style="{StaticResource Label}"
                                           FontSize="12"
                                           Margin="0,16,0,0" />

                                <ListBox Style="{StaticResource CleanListBox}"
                                         ItemsSource="{Binding DetailErrors}"
                                         MaxHeight="180"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding HasDetailErrors, Converter={StaticResource BooleanToVisibility}}"
                                         AutomationProperties.Name="{DynamicResource Strings.History.SkippedName}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}" FontSize="11" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Path}"
                                                               Style="{StaticResource Mono}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               ToolTip="{Binding Path}" />
                                                    <TextBlock Text="{Binding Message}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{DynamicResource Strings.History.NoSkipped}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasDetailErrors, Converter={StaticResource InverseBooleanToVisibility}}" />

                                <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,12" />

                                <Button Content="{DynamicResource Strings.History.RunAnother}"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding StartQuickScanCommand}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="{DynamicResource Strings.History.RunAnotherName}" />

                                <TextBlock Text="{DynamicResource Strings.History.Footer}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <controls:EmptyState Glyph="{StaticResource Icon.List}"
                                             Title="{DynamicResource Strings.History.SelectScanTitle}"
                                             Message="{DynamicResource Strings.History.SelectScan}"
                                             Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="{DynamicResource Strings.History.Footer}"
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
