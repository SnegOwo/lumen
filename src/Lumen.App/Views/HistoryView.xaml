<UserControl x:Class="Lumen.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerOutlineButton}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="Clear history"
                            Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Clear local scan history" />
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            Content="&#xE72C;"
                            Margin="8,0,0,0"
                            ToolTip="Refresh scan history"
                            AutomationProperties.Name="Refresh scan history" />
                </StackPanel>
            </Grid>

            <controls:Banner Title="Some history data could not be read"
                             Message="{Binding LoadWarning}"
                             Severity="Warning"
                             Margin="0,0,0,14"
                             Visibility="{Binding LoadWarning, Converter={StaticResource EmptyStringToVisibility}}" />

            <controls:Banner Title="{Binding BannerTitle}"
                             Message="{Binding BannerMessage}"
                             Severity="{Binding BannerSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissBannerCommand}"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty -->
            <Border Style="{StaticResource Card}"
                    MinHeight="390"
                    Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}">
                <controls:EmptyState Glyph="&#xE81C;"
                                     Title="No scan history yet"
                                     Message="Completed scans are recorded locally with their scope, counts and skipped items. File contents and paths are never written to the log."
                                     ActionText="Run a quick scan"
                                     ActionCommand="{Binding StartQuickScanCommand}" />
            </Border>

            <!-- History -->
            <Grid Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" MinHeight="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scans" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Rows.Count, StringFormat={}{0:N0} stored}"
                                       Style="{StaticResource Caption}" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource CleanListBox}"
                                 ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 MaxHeight="550"
                                 AutomationProperties.Name="Scan history entries">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource App.SurfaceAlt}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetections}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Cancelled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DateText}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding MetaText}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="10.5" />
                                                <TextBlock Text="&#x00B7;"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="10.5"
                                                           Margin="6,0" />
                                                <TextBlock Text="{Binding ScopeLabel}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="10.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource ChipBorder}"
                                                VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ChipText}" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" MinHeight="480">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="560"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DetailTitle}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailWhen}"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding DetailScope}"
                                           Style="{StaticResource Label}"
                                           Foreground="{DynamicResource App.TextSecondary}"
                                           Margin="0,8,0,0" />

                                <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Inspected" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.FilesScanned, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Findings" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.DetectionCount, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Warnings" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedRow.Source.ErrorCount, StringFormat={}{0:N0}}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Duration" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="{Binding DetailDuration}"
                                                       Style="{StaticResource Label}" FontSize="19" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding DetailCounts}"
                                           Style="{StaticResource BodySecondary}"
                                           FontSize="12.5"
                                           Margin="0,10,0,0" />

                                <TextBlock Text="Locations" Style="{StaticResource Label}" FontSize="12" Margin="0,16,0,0" />
                                <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0" Padding="12,10">
                                    <TextBlock Text="{Binding DetailRoots}"
                                               Style="{StaticResource Mono}"
                                               FontSize="11.5" />
                                </Border>

                                <TextBlock Text="{Binding DetailErrorsCaption}"
                                           Style="{StaticResource Label}"
                                           FontSize="12"
                                           Margin="0,16,0,0" />

                                <ListBox Style="{StaticResource CleanListBox}"
                                         ItemsSource="{Binding DetailErrors}"
                                         MaxHeight="180"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding HasDetailErrors, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="Skipped items from this scan">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}" FontSize="10" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Path}"
                                                               Style="{StaticResource Mono}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding Message}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="No skipped items were recorded for this scan."
                                           Style="{StaticResource Caption}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasDetailErrors, Converter={StaticResource InverseBoolToVisibility}}" />

                                <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,12" />

                                <Button Content="Run another quick scan"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding StartQuickScanCommand}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Run another quick scan" />

                                <TextBlock Text="History stores scan metadata only: scope, counts, paths and skipped items. It never stores file contents."
                                           Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE81C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Select a scan to review it"
                                       Style="{StaticResource BodySecondary}"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="Scan history is stored in this Windows account's app data. Clearing it does not affect quarantined files."
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
