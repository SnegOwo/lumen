<UserControl x:Class="Lumen.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charts="clr-namespace:Lumen.App.Views.Charts"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <UserControl.Resources>
        <Style x:Key="HeroPrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Hero.ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Hero.ButtonFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hero.ButtonBorder}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hero.ButtonBgHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Hero.ButtonBgHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hero.ButtonBgPressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Hero.ButtonBgPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeroGhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Hero.GhostBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Hero.GhostFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hero.GhostBorder}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconTileSmall" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="CheckBullet" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Page heading -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding FullScanCommand}"
                            ToolTip="{DynamicResource Strings.Dashboard.FullScanTip}"
                            AutomationProperties.Name="{DynamicResource Strings.Dashboard.FullScanName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.FullScan}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="" />
                            <TextBlock Text="{DynamicResource Strings.Dashboard.FullScan}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border Background="{DynamicResource Hero.Background}"
                    BorderBrush="{DynamicResource Hero.Border}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="30,26"
                    Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Hero.BadgeBackground}"
                                CornerRadius="99"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Strings.Dashboard.HeroBadge}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Hero.BadgeText}" />
                        </Border>

                        <TextBlock Text="{DynamicResource Strings.Dashboard.HeroHeadline}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Hero.Text}"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"
                                   HorizontalAlignment="Left"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="{DynamicResource Strings.Dashboard.HeroBody}"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Hero.TextMuted}"
                                   TextWrapping="Wrap"
                                   MaxWidth="590"
                                   HorizontalAlignment="Left"
                                   Margin="0,9,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="{DynamicResource Strings.Dashboard.QuickScan}"
                                    Style="{StaticResource HeroPrimaryButton}"
                                    Command="{Binding QuickScanCommand}"
                                    MinWidth="128"
                                    AutomationProperties.Name="{DynamicResource Strings.Dashboard.QuickScanName}" />
                            <Button Content="{DynamicResource Strings.Dashboard.ChooseFolder}"
                                    Style="{StaticResource HeroGhostButton}"
                                    Command="{Binding ChooseFolderCommand}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Dashboard.ChooseFolderName}" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Strings.Dashboard.HeroFootnote}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Hero.TextMuted}"
                                   Margin="0,14,0,0" />
                    </StackPanel>

                    <Grid Grid.Column="1"
                          Width="230"
                          Height="190"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse Width="196" Height="196" Stroke="{DynamicResource Hero.Ring}" StrokeThickness="1" />
                        <Ellipse Width="146" Height="146" Stroke="{DynamicResource Hero.Ring}" StrokeThickness="1" />
                        <Ellipse Width="98" Height="98" Fill="{DynamicResource Hero.Glow}" />
                        <TextBlock Text="{StaticResource Icon.Shield}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="52"
                                   Foreground="{DynamicResource Hero.GlyphFg}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Real-time protection. The card reports what the monitor is really
                 doing, including the parts it cannot cover. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                        <TextBlock Text="{StaticResource Icon.Shield}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource Accent.Text}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RealtimeStatusTitle}"
                                       Style="{StaticResource CardTitle}"
                                       controls:LiveRegion.IsEnabled="True" />
                            <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RealtimeBadgeText}" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RealtimeStatusDetail}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <!-- Coverage: how many of the configured folders are watched. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding RealtimeWatchedText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeCheckedText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeDetectionsText}" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- The counters that show where files are lost. -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding RealtimeQueueText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeDroppedText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeWatcherFailureText}" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- The last match, and the last error when there was one. -->
                        <TextBlock Text="{Binding RealtimeLastDetectionText}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520"
                                   ToolTip="{Binding RealtimeLastDetectionText}" />

                        <Border Background="{DynamicResource Warning.Soft}"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,8,0,0"
                                Visibility="{Binding RealtimeDegraded, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{DynamicResource Strings.Dashboard.RealtimeDegraded}"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextPrimary}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding RealtimeLastErrorText}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasRealtimeError, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenRealtimeSettingsCommand}"
                            Content="{DynamicResource Strings.Dashboard.RealtimeSettings}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="{DynamicResource Strings.Dashboard.RealtimeSettingsName}" />
                </Grid>
            </Border>

            <!-- Key status cards -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Last scan -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{StaticResource Icon.Scan}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastScanHasDetections}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastScanHasErrors}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastScanCancelled}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource Icon.Dismiss}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Strings.Dashboard.LastScan}"
                                       Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="{Binding LastScanStatus}" Style="{StaticResource ChipText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="{Binding LastScanTitle}"
                                       Style="{StaticResource CardTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding LastScanTitle}" />
                            <TextBlock Text="{Binding LastScanWhen}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastScanMeta}" Style="{StaticResource BodySecondary}"
                                       FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding LastScanMeta}" />
                            <Button Content="{DynamicResource Strings.Dashboard.ViewHistory}"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding ViewHistoryCommand}"
                                    IsEnabled="{Binding HasHistory}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Dashboard.ViewHistoryName}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quarantine -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock Text="{StaticResource Icon.Trash}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Strings.Dashboard.Quarantine}"
                                       Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding QuarantineCountText}" Style="{StaticResource Label}" FontSize="15" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding QuarantineCountText}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="{Binding QuarantineDetail}" Style="{StaticResource BodySecondary}"
                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <Button Content="{DynamicResource Strings.Dashboard.OpenQuarantine}"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenQuarantineCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Dashboard.OpenQuarantineName}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Defender -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock Text="{StaticResource Icon.Shield}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Strings.Dashboard.MicrosoftDefender}"
                                       Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <Border Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ChipBorder}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Defender.IsProtected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Success.Soft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Defender.IsOff}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Warning.Soft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Defender.BadgeText}" Style="{StaticResource ChipText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Defender.Title}"
                                       Style="{StaticResource CardTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding Defender.Title}" />
                            <TextBlock Text="{Binding Defender.Signature}" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding Defender.Signature}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{DynamicResource Strings.Dashboard.OpenWindowsSecurity}"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenWindowsSecurityCommand}"
                                        AutomationProperties.Name="{DynamicResource Strings.Dashboard.OpenWindowsSecurityName}" />
                                <Button Style="{StaticResource IconButton}"
                                        Width="28" Height="28"
                                        Margin="8,0,0,0"
                                        Content="{StaticResource Icon.Refresh}"
                                        Command="{Binding RefreshDefenderCommand}"
                                        ToolTip="{DynamicResource Strings.Dashboard.RefreshDefender}"
                                        AutomationProperties.Name="{DynamicResource Strings.Dashboard.RefreshDefenderName}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Activity chart and recent activity -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Detections per scan -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="230">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Strings.Dashboard.ActivityTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Strings.Dashboard.TrendSubtitle}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <charts:SparklineView Values="{Binding DetectionTrend}"
                                               Height="120"
                                               Margin="0,16,0,0"
                                               Visibility="{Binding HasCharts, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Text="{DynamicResource Strings.Dashboard.NoChartYet}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding HasCharts, Converter={StaticResource InverseBooleanToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Last scan breakdown -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0" MinHeight="230">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Strings.Dashboard.BreakdownTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Strings.Dashboard.BreakdownSubtitle}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <charts:BarChartView Values="{Binding LastScanBars}"
                                             Labels="{Binding LastScanBarLabels}"
                                             BrushKeys="{Binding LastScanBarBrushKeys}"
                                             Height="120"
                                             Margin="0,16,0,0"
                                             Visibility="{Binding HasCharts, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Text="{DynamicResource Strings.Dashboard.NoChartYet}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding HasCharts, Converter={StaticResource InverseBooleanToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Recent activity -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" MinHeight="230">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Strings.Dashboard.RecentActivity}" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Content="{DynamicResource Strings.Dashboard.ViewAll}"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding ViewHistoryCommand}"
                                    AutomationProperties.Name="{DynamicResource Strings.Dashboard.ViewAllName}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                    Background="{DynamicResource App.SurfaceAlt}"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           AutomationProperties.Name="">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{StaticResource Icon.Check}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDetections}" Value="True">
                                                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                    <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Cancelled}" Value="True">
                                                                    <Setter Property="Text" Value="{StaticResource Icon.Dismiss}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           ToolTip="{Binding Title}" />
                                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource ChipBorder}"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding HasDetections, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock Text="{Binding DetectionText}" Style="{StaticResource ChipText}" />
                                                </Border>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:EmptyState Glyph="{StaticResource Icon.List}"
                                                 Title="{DynamicResource Strings.Dashboard.NoActivityTitle}"
                                                 Message="{DynamicResource Strings.Dashboard.NoActivity}"
                                                 ActionText="{DynamicResource Strings.Dashboard.RunQuickScan}"
                                                 ActionCommand="{Binding QuickScanCommand}"
                                                 Visibility="{Binding HasRecentActivity, Converter={StaticResource InverseBooleanToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- What Lumen checks + the rules card -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Strings.Dashboard.ChecksTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Strings.Dashboard.ChecksSubtitle}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckEicarTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckEicarBody}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="{StaticResource Icon.ScriptRule}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Warning.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckScriptTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckScriptBody}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="{StaticResource Icon.FilenameRule}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Info.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckNameTitle}" Style="{StaticResource Label}" />
                                <TextBlock Text="{DynamicResource Strings.Dashboard.CheckNameBody}"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,12" />
                        <Button Content="{DynamicResource Strings.Dashboard.ReviewRules}"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{DynamicResource Strings.Dashboard.ReviewRulesName}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Strings.Dashboard.ActivityTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Strings.Dashboard.ActivitySubtitle}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="{Binding Defender.Detail}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Defender.CheckedText}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{DynamicResource Strings.Dashboard.Footer}"
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
