<UserControl x:Class="Lumen.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="HeroPrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#F0FDFA" />
            <Setter Property="Foreground" Value="#082F2C" />
            <Setter Property="BorderBrush" Value="#F0FDFA" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCFBF1" />
                    <Setter Property="BorderBrush" Value="#CCFBF1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#99F6E4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeroGhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource Hero.Text}" />
            <Setter Property="BorderBrush" Value="#3B6470" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconTileSmall" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="CheckBullet" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Page heading -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding FullScanCommand}"
                            AutomationProperties.Name="Open full scan options"
                            ToolTip="Review full scan options before starting">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Full scan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border Background="{DynamicResource Hero.Background}"
                    BorderBrush="{DynamicResource Hero.Border}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="30,26"
                    Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Hero.BadgeBackground}"
                                CornerRadius="99"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="ON-DEMAND  &#x00B7;  ON-ACCESS  &#x00B7;  LOCAL ONLY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Hero.BadgeText}" />
                        </Border>

                        <TextBlock Text="Your device, inspected on your terms."
                                   FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Hero.Text}"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"
                                   HorizontalAlignment="Left"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="On-demand scans, transparent rules, and a recoverable encrypted vault. No cloud, no telemetry, no background driver."
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Hero.TextMuted}"
                                   TextWrapping="Wrap"
                                   MaxWidth="590"
                                   HorizontalAlignment="Left"
                                   Margin="0,9,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Quick scan"
                                    Style="{StaticResource HeroPrimaryButton}"
                                    Command="{Binding QuickScanCommand}"
                                    MinWidth="128"
                                    AutomationProperties.Name="Start a quick scan" />
                            <Button Content="Choose a folder"
                                    Style="{StaticResource HeroGhostButton}"
                                    Command="{Binding ChooseFolderCommand}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.Name="Choose a folder to scan" />
                        </StackPanel>

                        <TextBlock Text="Files stay read-only until you confirm a quarantine."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Hero.TextMuted}"
                                   Margin="0,14,0,0" />
                    </StackPanel>

                    <Grid Grid.Column="1"
                          Width="230"
                          Height="190"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse Width="196" Height="196" Stroke="#332DD4BF" StrokeThickness="1" />
                        <Ellipse Width="146" Height="146" Stroke="#552DD4BF" StrokeThickness="1" />
                        <Ellipse Width="98" Height="98" Fill="{DynamicResource Hero.Glow}" />
                        <TextBlock Text="&#xEA18;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="52"
                                   Foreground="#7DE6D7"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Real-time protection -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                        <TextBlock Text="&#xEA18;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource Accent.Text}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RealtimeStatusTitle}" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RealtimeBadgeText}" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RealtimeStatusDetail}"
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding RealtimeCheckedText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeDetectionsText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="&#x00B7;" Style="{StaticResource Caption}" Margin="5,0" />
                            <TextBlock Text="{Binding RealtimeLastDetectionText}"
                                       Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="520" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenRealtimeSettingsCommand}"
                            Content="Settings"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Open real-time protection settings" />
                </Grid>
            </Border>

            <!-- Key status cards -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Last scan -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock Text="{Binding LastScanGlyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Last scan" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <Border Grid.Column="2" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="{Binding LastScanStatus}" Style="{StaticResource ChipText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="{Binding LastScanTitle}"
                                       Style="{StaticResource CardTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding LastScanWhen}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastScanMeta}" Style="{StaticResource BodySecondary}"
                                       FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <Button Content="View history"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding ViewHistoryCommand}"
                                    IsEnabled="{Binding HasHistory}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="View scan history" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quarantine -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Quarantine" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding QuarantineCountText}" Style="{StaticResource Label}" FontSize="15" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding QuarantineCountText}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="{Binding QuarantineDetail}" Style="{StaticResource BodySecondary}"
                                       FontSize="12" Margin="0,2,0,0" />
                            <Button Content="Open quarantine"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenQuarantineCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="Open the encrypted quarantine" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Defender -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" MinHeight="176">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconTileSmall}">
                                <TextBlock Text="&#xEA18;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Microsoft Defender" Style="{StaticResource KpiLabel}" Margin="10,0,0,0" />
                            <Border Grid.Column="2">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ChipBorder}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Defender.IsProtected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Success.Soft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Defender.IsOff}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Warning.Soft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Defender.BadgeText}" Style="{StaticResource ChipText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Defender.Title}"
                                       Style="{StaticResource CardTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Defender.Signature}" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Open Windows Security"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenWindowsSecurityCommand}"
                                        AutomationProperties.Name="Open Windows Security" />
                                <Button Style="{StaticResource IconButton}"
                                        Width="28" Height="28"
                                        Margin="8,0,0,0"
                                        Content="&#xE72C;"
                                        Command="{Binding RefreshDefenderCommand}"
                                        ToolTip="Refresh Defender status"
                                        AutomationProperties.Name="Refresh Microsoft Defender status" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Activity + rules -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Content="View all"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding ViewHistoryCommand}"
                                    AutomationProperties.Name="View all scan history" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                    Background="{DynamicResource App.SurfaceAlt}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource App.TextSecondary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success.Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDetections}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Cancelled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource ChipBorder}"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding HasDetections, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding DetectionText}" Style="{StaticResource ChipText}" />
                                                </Border>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No scans yet. Your scan results will appear here, stored only on this device.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodySecondary}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentActivity}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="Run a quick scan"
                                    Command="{Binding QuickScanCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="Run a quick scan">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentActivity}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" MinHeight="290">
                    <StackPanel>
                        <TextBlock Text="What Lumen checks" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Small, documented rules &#x2014; not a malware signature database."
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="EICAR test signature" Style="{StaticResource Label}" />
                                <TextBlock Text="Verifies scanner plumbing with the standard harmless test file."
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Warning.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Script heuristics" Style="{StaticResource Label}" />
                                <TextBlock Text="Looks for a few risky token combinations in readable scripts."
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CheckBullet}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Info.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Deceptive file names" Style="{StaticResource Label}" />
                                <TextBlock Text="Flags double extensions and bidirectional override characters."
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,12" />
                        <Button Content="Review detection rules"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Review detection rules in Settings" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Microsoft Defender should remain your primary antivirus. Lumen's real-time protection is a user-mode folder watcher that runs only while the app is open."
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
