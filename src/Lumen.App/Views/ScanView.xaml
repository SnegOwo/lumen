<UserControl x:Class="Lumen.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="SelectAllCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource Input.Background}"
                                    BorderBrush="{DynamicResource Input.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4"
                                      Stroke="{DynamicResource Accent.OnPrimary}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scan" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Inspect files on this device. Nothing is uploaded, and nothing changes until you confirm a quarantine."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Clear results"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearResultsCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Clear current scan results" />
            </Grid>

            <!-- Scan setup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Choose a scope" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Quick covers the folders most people care about. Full profile is broader but still skips system and app-data locations."
                                       Style="{StaticResource BodySecondary}"
                                       FontSize="12.5"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top">
                            <TextBlock Text="READ-ONLY" Style="{StaticResource ChipText}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,14,0,0" IsEnabled="{Binding IsNotScanning}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0"
                                     GroupName="ScanScope"
                                     Style="{StaticResource ChoiceCard}"
                                     Margin="0,0,6,0"
                                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=Quick, Mode=TwoWay}"
                                     AutomationProperties.Name="Quick scan: Desktop, Documents and Downloads">
                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource App.Surface}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Quick" Style="{StaticResource Label}" Margin="0,10,0,0" />
                                <TextBlock Text="Desktop, Documents, Downloads" Style="{StaticResource Caption}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1"
                                     GroupName="ScanScope"
                                     Style="{StaticResource ChoiceCard}"
                                     Margin="6,0,6,0"
                                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=FullUserProfile, Mode=TwoWay}"
                                     AutomationProperties.Name="Full profile scan of your user profile">
                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource App.Surface}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Full profile" Style="{StaticResource Label}" Margin="0,10,0,0" />
                                <TextBlock Text="Your user profile, minus app data" Style="{StaticResource Caption}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="2"
                                     GroupName="ScanScope"
                                     Style="{StaticResource ChoiceCard}"
                                     Margin="6,0,6,0"
                                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=Folder, Mode=TwoWay}"
                                     AutomationProperties.Name="Folder scan of a folder you choose">
                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource App.Surface}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Folder" Style="{StaticResource Label}" Margin="0,10,0,0" />
                                <TextBlock Text="One folder you choose" Style="{StaticResource Caption}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="3"
                                     GroupName="ScanScope"
                                     Style="{StaticResource ChoiceCard}"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=File, Mode=TwoWay}"
                                     AutomationProperties.Name="Single file scan">
                            <StackPanel>
                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource App.Surface}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Single file" Style="{StaticResource Label}" Margin="0,10,0,0" />
                                <TextBlock Text="One file you choose" Style="{StaticResource Caption}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Location" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedPathDisplay}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource App.TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="0,2,0,0"
                                           ToolTip="{Binding SelectedPathDisplay}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Choose&#x2026;"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Command="{Binding BrowseCommand}"
                                    IsEnabled="{Binding CanBrowse}"
                                    Visibility="{Binding IsCustomScope, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Choose a folder or file to scan" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ScopeDescription}"
                               Style="{StaticResource BodySecondary}"
                               FontSize="12.5"
                               Margin="2,10,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartScanCommand}"
                                    Content="{Binding ScanButtonText}"
                                    MinWidth="132"
                                    Visibility="{Binding IsNotScanning, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Start the selected scan" />
                            <Button Style="{StaticResource DangerOutlineButton}"
                                    Command="{Binding CancelScanCommand}"
                                    Content="{Binding CancelButtonText}"
                                    MinWidth="132"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Cancel the running scan" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Quarantine is a separate, confirmed action."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Running progress -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource Accent.Soft}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{DynamicResource Accent.Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PhaseText}"
                                       Style="{StaticResource CardTitle}"
                                       controls:LiveRegion.IsEnabled="True" />
                            <TextBlock Text="You can cancel at any time. Files already inspected are left untouched."
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Style="{StaticResource DangerOutlineButton}"
                                    Height="34"
                                    Command="{Binding CancelScanCommand}"
                                    Content="{Binding CancelButtonText}"
                                    AutomationProperties.Name="Cancel the running scan" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Style="{StaticResource ScanProgressBar}"
                                 IsIndeterminate="True"
                                 Margin="0,16,0,0"
                                 AutomationProperties.Name="Scan in progress" />

                    <TextBlock Text="{Binding CurrentFileDisplay}"
                               Style="{StaticResource Mono}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,12,0,0"
                               ToolTip="{Binding CurrentFileDisplay}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Inspected" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesScannedText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Findings" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding DetectionCountText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Skipped" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Elapsed" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action banner -->
            <controls:Banner Margin="0,14,0,0"
                             Title="{Binding ActionTitle}"
                             Message="{Binding ActionMessage}"
                             Severity="{Binding ActionSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissActionCommand}"
                             Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />

            <!-- Summary -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                <controls:Banner Title="{Binding SummaryTitle}"
                                 Message="{Binding SummaryMessage}"
                                 Severity="{Binding SummarySeverity}" />

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Files inspected" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesScannedText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Findings" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding DetectionCountText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Skipped" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Elapsed" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Results -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Findings" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource ChipBorder}" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource ChipText}">
                                    <Run Text="{Binding DetectionCountText, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding FindingsCaption, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource SelectAllCheckBox}"
                                      Content="Select all"
                                      IsChecked="{Binding AreAllSelected, Mode=TwoWay}"
                                      Margin="0,0,14,0"
                                      AutomationProperties.Name="Select all findings for quarantine" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="34"
                                    Command="{Binding QuarantineSelectedCommand}"
                                    Content="{Binding QuarantineButtonText}"
                                    AutomationProperties.Name="Quarantine the selected files" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Review each match before quarantining. Lumen never changes a file without your confirmation."
                               Style="{StaticResource Caption}"
                               Margin="0,6,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InsetCard}" Padding="8">
                            <ListBox Style="{StaticResource CleanListBox}"
                                     ItemsSource="{Binding Detections}"
                                     SelectedItem="{Binding SelectedDetection, Mode=TwoWay}"
                                     MaxHeight="440"
                                     MinHeight="190"
                                     AutomationProperties.Name="Detected files">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource SelectionCheckBox}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding SelectionName}" />

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Folder}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Style="{StaticResource ChipBorder}" Padding="6,1">
                                                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource ChipText}" FontSize="10" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ConfidenceLabel}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="10.5"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource App.TextMuted}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InsetCard}" Margin="10,0,0,0" Padding="16">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="420"
                                              Visibility="{Binding HasSelectedDetection, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedDetection.FileName}"
                                                   Style="{StaticResource CardTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDetection.FilePath}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <TextBlock Text="{Binding SelectedDetection.CategoryLabel}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedDetection.ConfidenceLabel}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </StackPanel>

                                        <Border Style="{StaticResource Divider}" />

                                        <TextBlock Text="{Binding SelectedDetection.Title}"
                                                   Style="{StaticResource Label}"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedDetection.Summary}"
                                                   Style="{StaticResource BodySecondary}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedDetection.Detail}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12.5"
                                                   Margin="0,8,0,0" />

                                        <Border Background="{DynamicResource Warning.Soft}"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding SelectedDetection.Advice, Converter={StaticResource EmptyStringToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE946;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Warning.Text}"
                                                           Margin="0,1,8,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding SelectedDetection.Advice}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource App.TextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Size" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.SizeText}"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource App.TextPrimary}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Detected" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.DetectedText}"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource App.TextPrimary}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SHA-256" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.HashShort}"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedDetection.Source.Sha256}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Copy path"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding CopySelectedPathCommand}"
                                                    AutomationProperties.Name="Copy the selected file path" />
                                            <Button Content="Show in Explorer"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding RevealSelectedCommand}"
                                                    Margin="14,0,0,0"
                                                    AutomationProperties.Name="Show the selected file in Explorer" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock Text="Select a finding to review its details."
                                           Style="{StaticResource BodySecondary}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasSelectedDetection, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Clean result -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}">
                <controls:EmptyState Glyph="&#xE73E;"
                                     Title="No matches found"
                                     Message="Lumen's limited rules did not match any inspected file. That does not prove the files are safe. Keep Microsoft Defender enabled and review skipped items below."
                                     ActionText="Scan again"
                                     ActionCommand="{Binding StartScanCommand}" />
            </Border>

            <!-- Skipped items -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{Binding ErrorsToggleText}"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding ToggleErrorsCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Show or hide skipped items" />

                <Border Style="{StaticResource InsetCard}"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsErrorsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ListBox Style="{StaticResource CleanListBox}"
                             ItemsSource="{Binding Errors}"
                             MaxHeight="220"
                             AutomationProperties.Name="Skipped or unreadable items">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}" FontSize="10" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Path}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Message}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="11.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <TextBlock Text="Lumen reads a limited prefix of each file for content checks. It never uploads file contents and never bypasses Windows permissions."
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
