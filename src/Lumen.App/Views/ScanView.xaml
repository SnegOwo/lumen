<UserControl x:Class="Lumen.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="900">

    <UserControl.Resources>
        <Style x:Key="SelectAllCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource Input.Background}"
                                    BorderBrush="{DynamicResource Input.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4"
                                      Stroke="{DynamicResource Accent.OnPrimary}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One reusable card for the four scan scopes. -->
        <DataTemplate x:Key="ScopeCard">
            <RadioButton GroupName="ScanScope"
                         Style="{StaticResource ChoiceCard}"
                         Margin="0,0,8,0"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource App.Surface}"
                            HorizontalAlignment="Left">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   AutomationProperties.Name="">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{StaticResource Icon.Search}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScopeKey}" Value="FullUserProfile">
                                            <Setter Property="Text" Value="{StaticResource Icon.Profile}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScopeKey}" Value="Folder">
                                            <Setter Property="Text" Value="{StaticResource Icon.Folder}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScopeKey}" Value="File">
                                            <Setter Property="Text" Value="{StaticResource Icon.File}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                               FontSize="11.5" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Body}" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- ==================== Heading ==================== -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.Scan.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Scan.Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource Strings.Scan.ClearResults}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearResultsCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasCompleted, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.Name="{DynamicResource Strings.Scan.ClearResultsName}" />
            </Grid>

            <!-- ==================== Zone 1: the scope ==================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Scan.ScopeTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource Strings.Scan.ScopeSubtitle}"
                                       Style="{StaticResource BodySecondary}"
                                       FontSize="12.5"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource Strings.Scan.ReadOnly}" Style="{StaticResource ChipText}" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ScopeOptions}"
                                  ItemTemplate="{StaticResource ScopeCard}"
                                  Margin="0,14,0,0"
                                  IsEnabled="{Binding IsNotScanning}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{StaticResource Icon.Folder}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="" />

                            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Strings.Scan.Location}" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedPathDisplay}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource App.TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="0,2,0,0"
                                           ToolTip="{Binding SelectedPathDisplay}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="{DynamicResource Strings.Scan.Choose}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Command="{Binding BrowseCommand}"
                                    IsEnabled="{Binding CanBrowse}"
                                    Visibility="{Binding IsCustomScope, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.ChooseName}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ScopeDescription}"
                               Style="{StaticResource BodySecondary}"
                               FontSize="12.5"
                               Margin="2,10,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartScanCommand}"
                                    Content="{Binding ScanButtonText}"
                                    MinWidth="132"
                                    Visibility="{Binding IsNotScanning, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.StartScanName}" />
                            <Button Style="{StaticResource DangerOutlineButton}"
                                    Command="{Binding CancelScanCommand}"
                                    Content="{Binding CancelButtonText}"
                                    MinWidth="132"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.CancelScanName}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource Icon.Trash}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="" />
                            <TextBlock Text="{DynamicResource Strings.Scan.QuarantineNote}"
                                       Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Zone 2: the live progress strip ==================== -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource Accent.Soft}" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource Icon.Radar}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{DynamicResource Accent.Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.Name="" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PhaseText}"
                                       Style="{StaticResource CardTitle}"
                                       controls:LiveRegion.IsEnabled="True" />
                            <TextBlock Text="{DynamicResource Strings.Scan.CancelNote}"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Label}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Style="{StaticResource DangerOutlineButton}"
                                    Height="34"
                                    Command="{Binding CancelScanCommand}"
                                    Content="{Binding CancelButtonText}"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.CancelScanName}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Style="{StaticResource ScanProgressBar}"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Margin="0,16,0,0"
                                 AutomationProperties.Name="{DynamicResource Strings.Scan.ProgressName}" />

                    <TextBlock Text="{Binding CurrentFileDisplay}"
                               Style="{StaticResource Mono}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,12,0,0"
                               ToolTip="{Binding CurrentFileDisplay}" />

                    <!-- Four counters: inspected, findings, skipped and warnings are
                         four different numbers and must not share a label. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Strings.Scan.Inspected}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesScannedText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Strings.Scan.Findings}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding DetectionCountText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Strings.Scan.Skipped}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesSkippedText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{DynamicResource Strings.Scan.Elapsed}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Label}" FontSize="17" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The quarantine progress. The user has to see that something is
                 happening while N files are encrypted. -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasQuarantineProgress, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Strings.Scan.QuarantineProgressTitle}"
                                   Style="{StaticResource CardTitle}"
                                   controls:LiveRegion.IsEnabled="True" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding QuarantineProgressText}"
                                   Style="{StaticResource Label}"
                                   Foreground="{DynamicResource App.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Style="{StaticResource ScanProgressBar}"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding QuarantineProgress, Mode=OneWay}"
                                 Margin="0,14,0,0"
                                 AutomationProperties.Name="{DynamicResource Strings.Scan.QuarantineProgressName}" />

                    <TextBlock Text="{Binding QuarantineCurrentFile}"
                               Style="{StaticResource Mono}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,12,0,0"
                               ToolTip="{Binding QuarantineCurrentFile}" />
                </StackPanel>
            </Border>

            <!-- Action banner -->
            <controls:Banner Margin="0,14,0,0"
                             Title="{Binding ActionTitle}"
                             Message="{Binding ActionMessage}"
                             Severity="{Binding ActionSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissActionCommand}"
                             Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibility}}" />

            <!-- The banners are announced to a screen reader. The live region sits
                 in a zero-height grid, so it costs nothing on screen. -->
            <Grid Height="0">
                <TextBlock Text="{Binding ActionAnnouncement}"
                           controls:LiveRegion.IsEnabled="True" />
                <TextBlock Text="{Binding SummaryAnnouncement}"
                           controls:LiveRegion.IsEnabled="True" />
            </Grid>

            <!-- ==================== Zone 3: the results ==================== -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibility}}">
                <controls:Banner Title="{Binding SummaryTitle}"
                                 Message="{Binding SummaryMessage}"
                                 Severity="{Binding SummarySeverity}" />

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Strings.Scan.FilesInspected}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesScannedText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Strings.Scan.Findings}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding DetectionCountText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Strings.Scan.Skipped}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding FilesSkippedText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{DynamicResource Strings.Scan.Warnings}" Style="{StaticResource Caption}" FontSize="11" />
                            <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Label}" FontSize="18" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Findings -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasFindings, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Strings.Scan.Findings}" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource ChipBorder}" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource ChipText}">
                                    <Run Text="{Binding DetectionCountText, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding FindingsCaption, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource SelectAllCheckBox}"
                                      Content="{DynamicResource Strings.Scan.SelectAll}"
                                      IsChecked="{Binding AreAllSelected, Mode=TwoWay}"
                                      Margin="0,0,14,0"
                                      AutomationProperties.Name="{DynamicResource Strings.Scan.SelectAllName}" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    Command="{Binding CleanSelectedCommand}"
                                    Content="{DynamicResource Strings.Scan.Clean}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.CleanName}" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="34"
                                    Command="{Binding QuarantineSelectedCommand}"
                                    Content="{Binding QuarantineButtonText}"
                                    AutomationProperties.Name="{DynamicResource Strings.Scan.QuarantineName}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Strings.Scan.ReviewNote}"
                               Style="{StaticResource Caption}"
                               Margin="0,6,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InsetCard}" Padding="8">
                            <ListBox Style="{StaticResource CleanListBox}"
                                     ItemsSource="{Binding Detections}"
                                     SelectedItem="{Binding SelectedDetection, Mode=TwoWay}"
                                     MaxHeight="440"
                                     MinHeight="190"
                                     AutomationProperties.Name="{DynamicResource Strings.Scan.DetectionsName}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource SelectionCheckBox}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding SelectionName}" />

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding FileName}" />
                                                <TextBlock Text="{Binding Folder}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,2,0,0"
                                                           ToolTip="{Binding Folder}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Style="{StaticResource ChipBorder}" Padding="6,1">
                                                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource ChipText}" FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ConfidenceLabel}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="11"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{StaticResource Icon.Chevron}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource App.TextMuted}"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InsetCard}" Margin="10,0,0,0" Padding="16">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="440"
                                              Visibility="{Binding HasSelectedDetection, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedDetection.FileName}"
                                                   Style="{StaticResource CardTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDetection.FilePath}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <TextBlock Text="{Binding SelectedDetection.CategoryLabel}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Border Style="{StaticResource ChipBorder}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedDetection.ConfidenceLabel}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </StackPanel>

                                        <Border Style="{StaticResource Divider}" />

                                        <TextBlock Text="{Binding SelectedDetection.Title}"
                                                   Style="{StaticResource Label}"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding SelectedDetection.Summary}"
                                                   Style="{StaticResource BodySecondary}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedDetection.Detail}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12.5"
                                                   Margin="0,8,0,0" />

                                        <Border Background="{DynamicResource Warning.Soft}"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding SelectedDetection.Advice, Converter={StaticResource EmptyStringToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource Icon.Info}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Warning.Text}"
                                                           Margin="0,1,8,0"
                                                           VerticalAlignment="Top"
                                                           AutomationProperties.Name="" />
                                                <TextBlock Text="{Binding SelectedDetection.Advice}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource App.TextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Strings.Scan.Size}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.SizeText}"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource App.TextPrimary}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Strings.Scan.Detected}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.DetectedText}"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource App.TextPrimary}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Strings.Scan.Sha256}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedDetection.HashShort}"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedDetection.Source.Sha256}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="{DynamicResource Strings.Scan.CopyPath}"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding CopySelectedPathCommand}"
                                                    AutomationProperties.Name="{DynamicResource Strings.Scan.CopyPathName}" />
                                            <Button Content="{DynamicResource Strings.Scan.ShowInExplorer}"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding RevealSelectedCommand}"
                                                    Margin="14,0,0,0"
                                                    AutomationProperties.Name="{DynamicResource Strings.Scan.ShowInExplorerName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <controls:EmptyState Glyph="{StaticResource Icon.Search}"
                                                     Title="{DynamicResource Strings.Scan.SelectFindingTitle}"
                                                     Message="{DynamicResource Strings.Scan.SelectFinding}"
                                                     Visibility="{Binding HasSelectedDetection, Converter={StaticResource InverseBooleanToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Clean result -->
            <Border Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasNoFindings, Converter={StaticResource BooleanToVisibility}}">
                <controls:EmptyState Glyph="{StaticResource Icon.Check}"
                                     Title="{DynamicResource Strings.Scan.NoMatchesTitle}"
                                     Message="{DynamicResource Strings.Scan.NoMatchesMessage}"
                                     ActionText="{DynamicResource Strings.Scan.ScanAgain}"
                                     ActionCommand="{Binding StartScanCommand}" />
            </Border>

            <!-- Skipped items -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibility}}">
                <Button Content="{Binding ErrorsToggleText}"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding ToggleErrorsCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{DynamicResource Strings.Scan.SkippedName}" />

                <Border Style="{StaticResource InsetCard}"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsErrorsExpanded, Converter={StaticResource BooleanToVisibility}}">
                    <ListBox Style="{StaticResource CleanListBox}"
                             ItemsSource="{Binding Errors}"
                             MaxHeight="220"
                             AutomationProperties.Name="{DynamicResource Strings.Scan.SkippedName}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}" FontSize="11" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Path}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding Message}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="11.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <TextBlock Text="{DynamicResource Strings.Scan.Footer}"
                       Style="{StaticResource Caption}"
                       Margin="2,14,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
