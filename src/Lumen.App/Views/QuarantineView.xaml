<UserControl x:Class="Lumen.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QuarantineViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quarantine" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource ChipBorder}" Margin="12,9,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource ChipText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Encrypted, integrity-checked copies that only you can restore or delete."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenVaultCommand}"
                            AutomationProperties.Name="Open the quarantine vault folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open vault folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            Content="&#xE72C;"
                            Margin="8,0,0,0"
                            ToolTip="Refresh the vault"
                            AutomationProperties.Name="Refresh quarantine items" />
                </StackPanel>
            </Grid>

            <controls:Banner Title="Some quarantine data could not be read"
                             Message="{Binding WarningText}"
                             Severity="Warning"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />

            <controls:Banner Title="{Binding BannerTitle}"
                             Message="{Binding BannerMessage}"
                             Severity="{Binding BannerSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissBannerCommand}"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty vault -->
            <Border Style="{StaticResource Card}"
                    MinHeight="390"
                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <controls:EmptyState Glyph="&#xE72E;"
                                     Title="The vault is empty"
                                     Message="{Binding EmptyDetail}"
                                     ActionText="Run a scan"
                                     ActionCommand="{Binding GoToScanCommand}" />
            </Border>

            <!-- Vault items -->
            <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" MinHeight="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Encrypted items" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Caption}" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource CleanListBox}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 MaxHeight="540"
                                 AutomationProperties.Name="Quarantined files">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                Background="{DynamicResource Accent.Soft}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="&#xE72E;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Accent.Text}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding OriginalPath}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource ChipBorder}" Padding="6,1">
                                                    <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource ChipText}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding SizeText}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="10.5"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RelativeText}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="10.5"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" MinHeight="480">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="560"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedItem.FileName}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedItem.OriginalPath}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <TextBlock Text="{Binding SelectedItem.CategoryLabel}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedItem.FindingTitle}"
                                                   Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding SelectedItem.FindingDetail}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12.5"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Info.Soft}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding SelectedItem.OriginalExists, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Info.Text}"
                                                   Margin="0,1,8,0"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Text="The original file still exists at its original location. It was not removed when the copy was quarantined."
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource App.SurfaceAlt}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding SelectedItem.HasNote, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Note" Style="{StaticResource Label}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedItem.Note}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quarantined" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.DateText}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SizeText}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SHA-256" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.HashShort}"
                                               Style="{StaticResource Mono}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               ToolTip="{Binding SelectedItem.Source.Sha256}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RestoreCommand}"
                                            Content="Restore"
                                            MinWidth="104"
                                            AutomationProperties.Name="Restore the selected file" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RestoreToCommand}"
                                            Content="Restore to&#x2026;"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Restore the selected file to another folder" />
                                    <Button Style="{StaticResource DangerOutlineButton}"
                                            Command="{Binding DeleteCommand}"
                                            Content="Delete permanently"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Permanently delete the encrypted copy" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Show original"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding RevealOriginalCommand}"
                                            AutomationProperties.Name="Show the original file if it still exists" />
                                    <Button Content="Copy original path"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding CopyPathCommand}"
                                            Margin="14,0,0,0"
                                            AutomationProperties.Name="Copy the original file path" />
                                </StackPanel>

                                <TextBlock Text="Restore decrypts the copy, verifies its SHA-256 hash, and only then writes the file. The encrypted copy is kept if verification fails."
                                           Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{DynamicResource App.TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Select an item to review it"
                                       Style="{StaticResource BodySecondary}"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Vault details -->
            <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE72E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource Accent.Text}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VaultSummary}" Style="{StaticResource Label}" FontSize="12.5" />
                        <TextBlock Text="AES-256-CBC encryption &#x00B7; HMAC-SHA256 integrity &#x00B7; per-user DPAPI-protected keys"
                                   Style="{StaticResource Caption}"
                                   FontSize="11.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding OpenVaultCommand}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Open the encrypted vault folder" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
