<UserControl x:Class="Lumen.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QuarantineViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Strings.Quarantine.Title}" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource ChipBorder}" Margin="12,9,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource ChipText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Quarantine.Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenVaultCommand}"
                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.OpenVaultName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="" />
                            <TextBlock Text="{DynamicResource Strings.Quarantine.OpenVault}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            Content="{StaticResource Icon.Refresh}"
                            Margin="8,0,0,0"
                            ToolTip="{DynamicResource Strings.Quarantine.RefreshVault}"
                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.RefreshVaultName}" />
                </StackPanel>
            </Grid>

            <controls:Banner Title="{DynamicResource Strings.Quarantine.ReadWarningTitle}"
                             Message="{Binding WarningText}"
                             Severity="Warning"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibility}}" />

            <controls:Banner Title="{Binding BannerTitle}"
                             Message="{Binding BannerMessage}"
                             Severity="{Binding BannerSeverity}"
                             ShowClose="True"
                             CloseCommand="{Binding DismissBannerCommand}"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibility}}" />

            <!-- The banner is announced to a screen reader. The live region sits in
                 a zero-height grid, so it costs nothing on screen. -->
            <Grid Height="0">
                <TextBlock Text="{Binding BannerAnnouncement}"
                           controls:LiveRegion.IsEnabled="True" />
            </Grid>

            <!-- The vault is busy. The user has to see that something is happening. -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasWorkProgress, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Quarantine.WorkTitle}"
                               Style="{StaticResource CardTitle}"
                               controls:LiveRegion.IsEnabled="True" />
                    <ProgressBar Style="{StaticResource ScanProgressBar}"
                                 IsIndeterminate="{Binding HasWorkProgress}"
                                 Margin="0,12,0,0"
                                 AutomationProperties.Name="{DynamicResource Strings.Quarantine.WorkName}" />
                    <TextBlock Text="{Binding WorkingLabel}"
                               Style="{StaticResource Mono}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,10,0,0"
                               ToolTip="{Binding WorkingLabel}" />
                </StackPanel>
            </Border>

            <!-- Empty vault -->
            <Border Style="{StaticResource Card}"
                    MinHeight="390"
                    Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibility}}">
                <controls:EmptyState Glyph="{StaticResource Icon.Trash}"
                                     Title="{DynamicResource Strings.Quarantine.EmptyTitle}"
                                     Message="{Binding EmptyDetail}"
                                     ActionText="{DynamicResource Strings.Quarantine.RunScan}"
                                     ActionCommand="{Binding GoToScanCommand}" />
            </Border>

            <!-- Vault items -->
            <Grid Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" MinHeight="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Strings.Quarantine.EncryptedItems}" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Caption}" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource CleanListBox}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 MaxHeight="540"
                                 AutomationProperties.Name="{DynamicResource Strings.Quarantine.ItemsName}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                Background="{DynamicResource Accent.Soft}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{StaticResource Icon.Trash}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Accent.Text}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding FileName}" />
                                            <TextBlock Text="{Binding OriginalPath}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="0,2,0,0"
                                                       ToolTip="{Binding OriginalPath}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource ChipBorder}" Padding="6,1">
                                                    <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource ChipText}" FontSize="11" />
                                                </Border>
                                                <TextBlock Text="{Binding SizeText}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="11"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RelativeText}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" MinHeight="480">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="560"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedItem.FileName}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedItem.OriginalPath}"
                                                   Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <TextBlock Text="{Binding SelectedItem.CategoryLabel}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedItem.FindingTitle}"
                                                   Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding SelectedItem.FindingDetail}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12.5"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Info.Soft}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding SelectedItem.OriginalExists, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource Icon.Info}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Info.Text}"
                                                   Margin="0,1,8,0"
                                                   VerticalAlignment="Top"
                                                   AutomationProperties.Name="" />
                                        <TextBlock Text="{DynamicResource Strings.Quarantine.OriginalExists}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource App.SurfaceAlt}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding SelectedItem.HasNote, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Strings.Quarantine.Note}" Style="{StaticResource Label}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedItem.Note}"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Strings.Quarantine.Quarantined}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.DateText}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Strings.Quarantine.Size}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SizeText}"
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Strings.Quarantine.Sha256}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.HashShort}"
                                               Style="{StaticResource Mono}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedItem.Source.Sha256}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,16,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RestoreCommand}"
                                            Content="{DynamicResource Strings.Quarantine.Restore}"
                                            MinWidth="104"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.RestoreName}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RestoreToCommand}"
                                            Content="{DynamicResource Strings.Quarantine.RestoreTo}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.RestoreToName}" />
                                    <Button Style="{StaticResource DangerOutlineButton}"
                                            Command="{Binding DeleteCommand}"
                                            Content="{DynamicResource Strings.Quarantine.Delete}"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.DeleteName}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource Strings.Quarantine.CleanFile}"
                                            Style="{StaticResource DangerOutlineButton}"
                                            Command="{Binding CleanFileCommand}"
                                            Height="32"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.CleanFileName}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource Strings.Quarantine.ShowOriginal}"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding RevealOriginalCommand}"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.ShowOriginalName}" />
                                    <Button Content="{DynamicResource Strings.Quarantine.CopyOriginalPath}"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding CopyPathCommand}"
                                            Margin="14,0,0,0"
                                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.CopyOriginalPathName}" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource Strings.Quarantine.RestoreExplainer}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <controls:EmptyState Glyph="{StaticResource Icon.Trash}"
                                             Title="{DynamicResource Strings.Quarantine.SelectItemTitle}"
                                             Message="{DynamicResource Strings.Quarantine.SelectItem}"
                                             Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Vault details -->
            <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{StaticResource Icon.Trash}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource Accent.Text}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="" />

                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VaultSummary}" Style="{StaticResource Label}" FontSize="12.5" />
                        <TextBlock Text="{DynamicResource Strings.Quarantine.VaultTech}"
                                   Style="{StaticResource Caption}"
                                   FontSize="11.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{DynamicResource Strings.Quarantine.OpenFolder}"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding OpenVaultCommand}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource Strings.Quarantine.OpenFolderName}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
