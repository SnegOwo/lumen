<UserControl x:Class="Lumen.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Lumen.App.Controls"
             xmlns:vm="clr-namespace:Lumen.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1050"
             d:DesignHeight="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Strings.Settings.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Style="{StaticResource ChipBorder}" HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource Strings.Settings.SavedAutomatically}" Style="{StaticResource ChipText}" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <controls:Banner Title="{DynamicResource Strings.Settings.SaveErrorTitle}"
                             Message="{Binding SaveErrorText}"
                             Severity="Warning"
                             ShowClose="True"
                             CloseCommand="{Binding DismissSaveErrorCommand}"
                             Margin="0,0,0,14"
                             Visibility="{Binding HasSaveError, Converter={StaticResource BooleanToVisibility}}" />

            <!-- ==================== Language ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.LanguageTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.LanguageBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton GroupName="SettingsLanguage"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=English, Mode=TwoWay}"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.LanguageEnglishName}">
                            <TextBlock Text="{DynamicResource Strings.Settings.LanguageEnglish}" VerticalAlignment="Center" />
                        </RadioButton>
                        <RadioButton GroupName="SettingsLanguage"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=Francais, Mode=TwoWay}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.LanguageFrenchName}">
                            <TextBlock Text="{DynamicResource Strings.Settings.LanguageFrench}" VerticalAlignment="Center" />
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== Appearance ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.AppearanceTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.AppearanceBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton GroupName="SettingsTheme"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System, Mode=TwoWay}"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.ThemeSystemName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.SystemTheme}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Settings.ThemeSystem}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SettingsTheme"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light, Mode=TwoWay}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.ThemeLightName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Moon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Settings.ThemeLight}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SettingsTheme"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark, Mode=TwoWay}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.ThemeDarkName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Sun}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Settings.ThemeDark}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SettingsTheme"
                                     Style="{StaticResource PillRadio}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=HighContrast, Mode=TwoWay}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="{DynamicResource Strings.Settings.ThemeHighContrastName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Warning}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                                <TextBlock Text="{DynamicResource Strings.Settings.ThemeHighContrast}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== Scanning ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.ScanningTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.ScanningBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Strings.Settings.MaxPrefix}"
                                   Style="{StaticResource Label}" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBorder}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding MaxInspectText}" Style="{StaticResource ChipText}" />
                        </Border>

                        <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Style="{StaticResource RangeSlider}"
                                Minimum="1"
                                Maximum="16"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding MaxInspectMegabytes, Mode=TwoWay}"
                                Foreground="{DynamicResource Accent.Primary}"
                                Margin="0,10,0,0"
                                AutomationProperties.Name="{DynamicResource Strings.Settings.MaxPrefixName}"
                                ToolTip="{DynamicResource Strings.Settings.SliderTooltip}" />
                    </Grid>

                    <TextBlock Text="{Binding InspectLimitDetail}"
                               Style="{StaticResource Caption}"
                               Margin="0,7,0,0" />

                    <Border Style="{StaticResource Divider}" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding LoggingEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.LoggingLabel}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.LoggingLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.LoggingBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ==================== Aggressive mode ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.AggressiveTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.AggressiveBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding AggressiveMode, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AggressiveName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AggressiveLabel}" Style="{StaticResource Label}" />
                        </StackPanel>
                    </CheckBox>

                    <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0" Padding="14,12">
                        <TextBlock Text="{DynamicResource Strings.Settings.AggressiveWarning}"
                                   Style="{StaticResource Caption}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== Real-time protection ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.RealtimeTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.RealtimeBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding RealtimeProtectionEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.RealtimeName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.RealtimeLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding RealtimeStatusText}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding RealtimeAutoQuarantine, Mode=TwoWay}"
                              Margin="0,14,0,0"
                              IsEnabled="{Binding RealtimeProtectionEnabled}"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AutoQuarantineName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AutoQuarantineLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.AutoQuarantineBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding RealtimeAutoKill, Mode=TwoWay}"
                              Margin="0,14,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AutoKillName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AutoKillLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.AutoKillBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <!-- How fast it reacts -->
                    <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.ReactivityTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.ReactivityBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Strings.Settings.SettleDelayLabel}"
                                           Style="{StaticResource Label}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RealtimeSettleDelayText}"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource RangeSlider}"
                                    Minimum="0"
                                    Maximum="1000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding RealtimeSettleDelayMs, Mode=TwoWay}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Settings.SettleDelayName}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.SettleDelayBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Strings.Settings.WorkerCountLabel}"
                                           Style="{StaticResource Label}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RealtimeWorkerCount}"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource RangeSlider}"
                                    Minimum="1"
                                    Maximum="8"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding RealtimeWorkerCount, Mode=TwoWay}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Settings.WorkerCountName}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.WorkerCountBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- How long Lumen stays quiet about a file it already reported -->
                    <Border Style="{StaticResource InsetCard}" Margin="0,10,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Strings.Settings.AlertCooldownLabel}" Style="{StaticResource Label}" />
                                <TextBlock Text="{DynamicResource Strings.Settings.AlertCooldownBody}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,2,0,0"
                                           AutomationProperties.Name="{DynamicResource Strings.Settings.AlertCooldownName}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AlertCooldownText}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Watched folders -->
                    <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.WatchedTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.WatchedBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />

                            <ItemsControl ItemsSource="{Binding WatchedFolders}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource LinkButton}"
                                                    Content="{DynamicResource Strings.Settings.RemoveFolder}"
                                                    Command="{Binding DataContext.RemoveWatchedFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{DynamicResource Strings.Settings.RemoveFolderName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Strings.Settings.NoWatched}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasNoWatchedFolders, Converter={StaticResource BooleanToVisibility}}" />

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="{DynamicResource Strings.Settings.AddFolder}"
                                    Command="{Binding AddWatchedFolderCommand}"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Settings.AddFolderName}" />
                        </StackPanel>
                    </Border>

                    <!-- Excluded folders -->
                    <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.ExcludedTitle}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.ExcludedBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />

                            <ItemsControl ItemsSource="{Binding ExcludedFolders}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}"
                                                       Style="{StaticResource Mono}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource LinkButton}"
                                                    Content="{DynamicResource Strings.Settings.RemoveFolder}"
                                                    Command="{Binding DataContext.RemoveExcludedFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{DynamicResource Strings.Settings.RemoveFolderName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Strings.Settings.NoExcluded}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasNoExcludedFolders, Converter={StaticResource BooleanToVisibility}}" />

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="{DynamicResource Strings.Settings.AddFolder}"
                                    Command="{Binding AddExcludedFolderCommand}"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{DynamicResource Strings.Settings.AddFolderName}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Strings.Settings.RealtimeFootnote}"
                               Style="{StaticResource Caption}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ==================== Remediation ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.RemediationTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.RemediationBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <Border Background="{DynamicResource Warning.Soft}"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Strings.Settings.RemediationWarning}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource App.TextPrimary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding RemediationEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.RemediationName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.RemediationLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.RemediationSwitchBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ==================== Detection alert ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.AlertTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.AlertBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding DetectionAlertEnabled, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AlertShowName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertShowLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertShowBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding DetectionAlertSoundEnabled, Mode=TwoWay}"
                              Margin="0,14,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AlertSoundName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertSoundLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertSoundBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding DetectionAlertCatEnabled, Mode=TwoWay}"
                              Margin="0,14,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.AlertCatName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertCatLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.AlertCatBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ==================== Window and tray ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.TrayTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.TrayBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.MinimizeToTrayName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.MinimizeToTrayLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.MinimizeToTrayBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}"
                              Margin="0,14,0,0"
                              AutomationProperties.Name="{DynamicResource Strings.Settings.TrayNotificationsName}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.TrayNotificationsLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.TrayNotificationsBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ==================== Microsoft Defender ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.DefenderTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.DefenderBody}"
                                       Style="{StaticResource BodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Defender.BadgeText}" Style="{StaticResource ChipText}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource Accent.Soft}" VerticalAlignment="Top">
                                <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.Name="" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="{Binding Defender.Title}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding Defender.Detail}"
                                           Style="{StaticResource BodySecondary}"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Defender.Signature}"
                                           Style="{StaticResource Caption}"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Defender.CheckedText}"
                                           Style="{StaticResource Caption}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding RefreshDefenderCommand}"
                                        Content="{StaticResource Icon.Refresh}"
                                        ToolTip="{DynamicResource Strings.Dashboard.RefreshDefender}"
                                        AutomationProperties.Name="{DynamicResource Strings.Dashboard.RefreshDefenderName}" />
                                <Button Content="{DynamicResource Strings.Dashboard.OpenWindowsSecurity}"
                                        Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenWindowsSecurityCommand}"
                                        Margin="8,6,0,0"
                                        AutomationProperties.Name="{DynamicResource Strings.Dashboard.OpenWindowsSecurityName}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== Detection rules ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Strings.Settings.RulesTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.RulesBody}"
                                       Style="{StaticResource BodySecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding RulesCountText}" Style="{StaticResource ChipText}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="14,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="360">
                            <ItemsControl ItemsSource="{Binding RuleGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,6">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Hint}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0" />

                                            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12.5"
                                                                               TextWrapping="Wrap" />
                                                                    <Border Style="{StaticResource ChipBorder}"
                                                                            Margin="8,0,0,0"
                                                                            Padding="6,1"
                                                                            Visibility="{Binding IsTestSignature, Converter={StaticResource BooleanToVisibility}}">
                                                                        <TextBlock Text="{DynamicResource Strings.Settings.TestSignature}"
                                                                                   Style="{StaticResource ChipText}"
                                                                                   FontSize="11" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Style="{StaticResource Caption}"
                                                                           FontSize="11.5"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding ConfidenceLabel}"
                                                                           Style="{StaticResource Caption}"
                                                                           FontSize="11"
                                                                           Margin="0,4,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== Data and privacy ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.DataTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.DataBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0" Padding="0">
                        <StackPanel>
                            <Grid Margin="14,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Strings.Settings.DataRow}" Style="{StaticResource Label}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DataPathText}" Style="{StaticResource Mono}"
                                           FontSize="11" Margin="12,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding DataPathText}" />
                                <Button Grid.Column="2" Content="{DynamicResource Strings.Settings.Open}" Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource Strings.Settings.OpenName}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource App.Border}" />
                            <Grid Margin="14,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Strings.Settings.QuarantineRow}" Style="{StaticResource Label}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding QuarantinePathText}" Style="{StaticResource Mono}"
                                           FontSize="11" Margin="12,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding QuarantinePathText}" />
                                <Button Grid.Column="2" Content="{DynamicResource Strings.Settings.Open}" Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenQuarantineFolderCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource Strings.Settings.OpenName}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource App.Border}" />
                            <Grid Margin="14,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Strings.Settings.LogRow}" Style="{StaticResource Label}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LogPathText}" Style="{StaticResource Mono}"
                                           FontSize="11" Margin="12,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding LogPathText}" />
                                <Button Grid.Column="2" Content="{DynamicResource Strings.Settings.Open}" Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenLogFolderCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource Strings.Settings.OpenName}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== Test tools ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.TestToolsTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource Strings.Settings.TestToolsBody}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,4,0,0" />

                    <controls:Banner Margin="0,12,0,0"
                                     Severity="Warning"
                                     Title="{DynamicResource Strings.Settings.HarmlessTitle}"
                                     Message="{DynamicResource Strings.Settings.HarmlessBody}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Strings.Settings.SamplesLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.SamplesBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CreateSamplesCommand}"
                                Content="{DynamicResource Strings.Settings.CreateSamples}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Strings.Settings.CreateSamplesName}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Strings.Settings.EicarLabel}" Style="{StaticResource Label}" />
                            <TextBlock Text="{DynamicResource Strings.Settings.EicarBody}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource DangerOutlineButton}"
                                Command="{Binding CreateEicarCommand}"
                                Content="{DynamicResource Strings.Settings.CreateEicar}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Strings.Settings.CreateEicarName}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== About ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Strings.Settings.AboutTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding AboutText}"
                               Style="{StaticResource BodySecondary}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource Strings.Settings.AboutFooter}"
                               Style="{StaticResource Caption}"
                               Margin="0,10,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding VersionText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetDefaultsCommand}"
                                Content="{DynamicResource Strings.Settings.RestoreDefaults}"
                                AutomationProperties.Name="{DynamicResource Strings.Settings.RestoreDefaultsName}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Strings.Settings.Footer}"
                       Style="{StaticResource Caption}"
                       Margin="2,0,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
