<Window x:Class="Lumen.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:Lumen.App.Infrastructure"
        mc:Ignorable="d"
        Title="Lumen"
        Width="520"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="Lumen dialog">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Window.Resources>

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.32" Color="#000000" />
        </Border.Effect>

        <Grid Margin="26,24,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconTile" Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                        Background="{DynamicResource Info.Soft}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource Info.Text}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           Style="{StaticResource SectionTitle}"
                           FontSize="19"
                           Margin="14,0,12,0"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="32" Height="32"
                        Content="&#xE711;"
                        AutomationProperties.Name="Close dialog"
                        ToolTip="Close"
                        Click="CloseButton_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Style="{StaticResource BodySecondary}"
                       FontSize="13.5"
                       LineHeight="21"
                       Margin="0,16,0,0" />

            <Border Grid.Row="2"
                    Style="{StaticResource InsetCard}"
                    Margin="0,16,0,0"
                    MaxHeight="170"
                    Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBox Text="{Binding Details, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource App.TextSecondary}"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             FontSize="11.5"
                             Padding="0"
                             IsTabStop="True"
                             AutomationProperties.Name="Dialog details" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="{Binding CancelText}"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"
                            Click="CancelButton_Click" />
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="{Binding PrimaryText}"
                            MinWidth="104"
                            Visibility="{Binding IsDanger, Converter={StaticResource InverseBoolToVisibility}}"
                            Click="PrimaryButton_Click" />
                    <Button x:Name="DangerButton"
                            Style="{StaticResource DangerButton}"
                            Content="{Binding PrimaryText}"
                            MinWidth="104"
                            Visibility="{Binding IsDanger, Converter={StaticResource BoolToVisibility}}"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
