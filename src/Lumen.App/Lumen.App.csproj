<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen.App</RootNamespace>
    <ApplicationIcon>Assets\lumen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Lumen</Product>
    <AssemblyTitle>Lumen</AssemblyTitle>
    <Description>Transparent local file inspection</Description>
    <Company>Lumen</Company>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 asks us to move the DPI settings out of app.manifest and into
         ApplicationHighDpiMode. That is correct for a WinForms app, but this app is
         WPF-primary and Windows Forms is used only for the notification-area icon.
         WPF reads its PerMonitorV2 awareness from the manifest, so the manifest
         entries are deliberate and the analyzer is silenced here instead. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Forms and Drawing are used only for the tray icon. Avoid global usings
         that would make Application, UserControl, KeyEventArgs and Brush ambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lumen.ico" />
  </ItemGroup>

  <!-- The cat is a PHOTO, and it travels inside the executable.
       Drop the picture at assets\cat.jpg (or assets\cat.png) in the repository and it is
       embedded automatically. When no picture is there, the interface falls back to a
       simple drawn cat, so the build never depends on it. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\assets\cat.jpg')">
    <Resource Include="..\..\assets\cat.jpg" Link="Assets\cat.jpg" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\assets\cat.png')">
    <Resource Include="..\..\assets\cat.png" Link="Assets\cat.png" />
  </ItemGroup>

</Project>
